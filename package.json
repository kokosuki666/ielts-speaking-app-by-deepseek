{
  "name": "ielts-speaking-webapp",
  "private": true,
  "version": "1.4.9",
  "description": "IELTS Speaking practice studio: question bank import, paper builder, AI examiner, neural TTS, conversation and vocabulary",
  "author": "IELTS Speaking Studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.mjs --serve",
    "preview": "vite preview",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win",
    "backup": "node scripts/backup.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "mammoth": "^1.13.0",
    "msedge-tts": "^2.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "unpdf": "^1.9.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
